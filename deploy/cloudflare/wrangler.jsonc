// Site público da Aruá (aruasolucoes.com.br): só arquivos estáticos, sem servidor e sem banco.
// Publicar: npm run deploy:site (exige aprovação do responsável).
{
  // Mesmo nome do Worker ligado ao repositório no Cloudflare (Workers Builds).
  "name": "arua-central",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/client",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "aruasolucoes.com.br", "custom_domain": true },
    { "pattern": "www.aruasolucoes.com.br", "custom_domain": true },
  ],
  "workers_dev": false,
}
